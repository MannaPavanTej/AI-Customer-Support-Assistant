# Environment Configuration Template
# Copy this file to .env and fill in values if external APIs are used later.

APP_ENV=development
APP_DEBUG=true
PORT=8501

# Enable before handling real customer data. Never commit the populated .env.
AUTH_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
